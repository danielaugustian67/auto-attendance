# Aktifkan minimal satu channel. Telegram dan WhatsApp boleh aktif bersamaan.

# Telegram (aktif bila token diisi; kosongkan untuk mematikan)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ALLOWED_USER_ID="123456789" # Batasi agar hanya kamu yang bisa pakai bot ini

# WhatsApp via whatsmeow (tidak resmi: pakai NOMOR KEDUA untuk bot)
WA_ENABLED=false
WA_ALLOWED_NUMBER="081234567890" # nomor KAMU yang dilayani bot (bukan nomor bot)
WA_BOT_NUMBER=""                 # opsional: isi nomor bot untuk login via kode tautan (tanpa scan QR)
WA_SESSION_DB="storage_state/whatsapp.db"

# 9Router AI Gateway Configuration
ROUTER_BASE_URL="http://localhost:20128/v1"
ROUTER_API_KEY="sk-dummy-or-your-key"
AI_MODEL_NAME="gpt-4o-mini" # atau model lain yang terdaftar di 9router

# Akun Kemnaker SIAPkerja. Kosongkan bila bot cukup menyusun draf tanpa mengirim ke Monev.
SIAPKERJA_EMAIL="user@example.com"
SIAPKERJA_PASSWORD="your_password"

# Browser untuk login & submit Monev (Chrome`/Chromium harus terpasang)
HEADLESS=true                              # false = tampilkan jendela browser (debug di laptop)
CHROME_PATH=""                             # opsional; kosong = cari Chrome/Chromium otomatis
BROWSER_PROFILE_DIR="storage_state/chrome" # menyimpan sesi login agar tidak login ulang tiap hari

# Jadwal pengingat (format HH:MM, dipisah koma) dan zona waktunya
REMINDER_TIMES="17:00,21:00"
TZ_LOCATION="Asia/Jakarta"
